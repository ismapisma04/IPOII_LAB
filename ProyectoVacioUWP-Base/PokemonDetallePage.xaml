<Page
    x:Class="ProyectoVacioUWP_Base.PokemonDetallePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="FondoDetalleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0F172A" Offset="0"/>
            <GradientStop Color="#FF1E3A5F" Offset="0.55"/>
            <GradientStop Color="#FF2563EB" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TituloCampoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFBFE3FF"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValorCampoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource FondoDetalleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="24,24,24,12"
            Padding="24,18"
            CornerRadius="22"
            Background="#2AFFFFFF"
            BorderBrush="#50FFFFFF"
            BorderThickness="1">

            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="txtTituloPrincipal"
                    Text="Detalle del Pokémon"
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Información completa del Pokémon seleccionado en la Pokédex."
                    FontSize="15"
                    Foreground="#E6FFFFFF"
                    TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="24,0,24,24"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid
                MaxWidth="1300"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta visual del Pokémon -->
                <Border
                    Grid.Column="0"
                    Padding="24"
                    CornerRadius="24"
                    Background="#20FFFFFF"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Top">

                    <StackPanel Spacing="18">
                        <TextBlock
                            Text="Vista del Pokémon"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"/>

                        <Border
                            Background="#10FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="20"
                            MinHeight="420">

                            <Viewbox
                                x:Name="vbPokemon"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tarjeta de datos -->
                <Border
                    Grid.Column="2"
                    Padding="28"
                    CornerRadius="24"
                    Background="#28FFFFFF"
                    BorderBrush="#4DFFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Top">

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="txtNombre"
                            Text="Nombre"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"
                            TextWrapping="WrapWholeWords"/>

                        <TextBlock
                            x:Name="txtSubtitulo"
                            Text="Ficha completa"
                            FontSize="15"
                            Foreground="#FFD7ECFF"
                            Margin="0,0,0,16"/>

                        <Border
                            Background="#14FFFFFF"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Vida" Style="{StaticResource TituloCampoStyle}"/>
                                <ProgressBar
                                    x:Name="pbVidaDetalle"
                                    Minimum="0"
                                    Maximum="100"
                                    Height="16"
                                    Value="0"/>

                                <TextBlock
                                    x:Name="txtVidaValor"
                                    Text="0 / 100"
                                    FontSize="13"
                                    Foreground="#FFEAF6FF"
                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#14FFFFFF"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Energía" Style="{StaticResource TituloCampoStyle}"/>
                                <ProgressBar
                                    x:Name="pbEnergiaDetalle"
                                    Minimum="0"
                                    Maximum="100"
                                    Height="16"
                                    Value="0"/>

                                <TextBlock
                                    x:Name="txtEnergiaValor"
                                    Text="0 / 100"
                                    FontSize="13"
                                    Foreground="#FFEAF6FF"
                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Categoría" Style="{StaticResource TituloCampoStyle}"/>
                        <TextBlock x:Name="txtCategoria" Style="{StaticResource ValorCampoStyle}"/>

                        <TextBlock Text="Tipo" Style="{StaticResource TituloCampoStyle}"/>
                        <TextBlock x:Name="txtTipo" Style="{StaticResource ValorCampoStyle}"/>

                        <TextBlock Text="Altura" Style="{StaticResource TituloCampoStyle}"/>
                        <TextBlock x:Name="txtAltura" Style="{StaticResource ValorCampoStyle}"/>

                        <TextBlock Text="Peso" Style="{StaticResource TituloCampoStyle}"/>
                        <TextBlock x:Name="txtPeso" Style="{StaticResource ValorCampoStyle}"/>

                        <TextBlock Text="Evolución" Style="{StaticResource TituloCampoStyle}"/>
                        <TextBlock x:Name="txtEvolucion" Style="{StaticResource ValorCampoStyle}"/>

                        <TextBlock Text="Descripción" Style="{StaticResource TituloCampoStyle}"/>
                        <Border
                            Background="#12FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                            <TextBlock
                                x:Name="txtDescripcion"
                                FontSize="17"
                                Foreground="White"
                                TextWrapping="WrapWholeWords"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>