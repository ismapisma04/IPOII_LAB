<Page
    x:Class="ProyectoVacioUWP_Base.PokedexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="FondoPokedexBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0F172A" Offset="0"/>
            <GradientStop Color="#FF1E3A5F" Offset="0.55"/>
            <GradientStop Color="#FF2563EB" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource FondoPokedexBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="24,24,24,12"
            Padding="24,18"
            CornerRadius="20"
            Background="#33FFFFFF"
            BorderBrush="#55FFFFFF"
            BorderThickness="1">

            <StackPanel Spacing="6">
                <TextBlock
                    Text="Pokémon disponibles"
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Pulsa sobre cualquier tarjeta para abrir la información detallada."
                    FontSize="15"
                    TextWrapping="WrapWholeWords"
                    Foreground="#E6FFFFFF"/>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="24,0,24,24"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled">

            <Border
                MaxWidth="1100"
                HorizontalAlignment="Center"
                Padding="24"
                CornerRadius="20"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">

                <StackPanel Spacing="18">
                    <TextBlock
                        Text="Lista de la Pokédex"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Busca por nombre o por texto de la descripción."
                        FontSize="14"
                        Foreground="#DDEAFBFF"
                        TextWrapping="WrapWholeWords"/>

                    <Border
                        Background="#22FFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10">
                        <TextBox
                            x:Name="txtBusquedaPokemon"
                            PlaceholderText="Buscar Pokémon..."
                            TextChanged="txtBusquedaPokemon_TextChanged"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"/>
                    </Border>

                    <TextBlock
                        x:Name="txtResultados"
                        Text="Mostrando todos los Pokémon"
                        FontSize="14"
                        Foreground="#E6FFFFFF"/>

                    <StackPanel
                        x:Name="spPokemons"
                        Spacing="18"
                        HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>