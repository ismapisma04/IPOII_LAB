<Page
    x:Class="ProyectoVacioUWP_Base.paginaConfiguracion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- Fondo azul estilo Pokédex -->

        <LinearGradientBrush x:Key="FondoAcercaBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">

            <GradientStop Color="#FF0F172A" Offset="0"/>
            <GradientStop Color="#FF1E3A5F" Offset="0.55"/>
            <GradientStop Color="#FF2563EB" Offset="1"/>

        </LinearGradientBrush>

    </Page.Resources>

    <Grid Background="{StaticResource FondoAcercaBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">

            <StackPanel Margin="30"
                        Spacing="24">

                <!-- TÍTULO -->

                <Border Background="#22FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="28">

                    <StackPanel Spacing="10">

                        <TextBlock x:Uid="AcercaDeConfiguracion"
                                   Text="CONFIGURACIÓN"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>


                        <TextBlock x:Uid="SobreConfiguracion"
                                   Text="Ajusta tus necesidades a nuestra aplicación sobre combates Pokemon"
                                   FontSize="18"
                                   Foreground="#DDEAFBFF"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- DESCRIPCIÓN -->

                <Border Background="#1EFFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">

                    <StackPanel Spacing="18">

                        <TextBlock x:Uid="PerfilDeUsuario"
                                   Text="Perfil del Usuario"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock
                            x:Uid="AcercaDeIdioma"
                            Text="idioma de la aplicación"
                            TextWrapping="WrapWholeWords"
                            FontSize="18"
                            Foreground="#E6FFFFFF"
                            LineHeight="30"/>

                        <ComboBox x:Name="Cambiar_Idioma" x:Uid="Cambiar_Idioma" Width="170" 
                                  Loaded="Cambiar_Idioma_Loaded" SelectionChanged="Cambiar_Idioma_SelectionChanged">
                            <ComboBoxItem x:Uid="OpcionEspanol" Content="Español" Tag="es"/>
                            <ComboBoxItem x:Uid="OpcionIngles" Content="Inglés" Tag="en"/>
                        </ComboBox>

                        <TextBlock
                            x:Uid="GestionDeNotificaciones"
                            Text="Gestión de notificaciones"
                            TextWrapping="WrapWholeWords"
                            FontSize="18"
                            Foreground="#E6FFFFFF"
                            LineHeight="30"/>

                        <ComboBox x:Name="Gestion_Notificaciones" x:Uid="Gestion_Notificaciones" Width="170" 
                                  Loaded="Gestion_Notificaciones_Loaded" SelectionChanged="Gestion_Notificaciones_SelectionChanged">
                            <ComboBoxItem x:Uid="OpcionNotificacionesOn" Content="Activadas" Tag="On"/>
                            <ComboBoxItem x:Uid="OpcionNotificacionesOff" Content="Desactivadas" Tag="Off"/>
                        </ComboBox>


                    </StackPanel>
                        

                </Border>

                <!-- PARTICIPANTES -->

                <Border Background="#1EFFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="26">

                    <StackPanel Spacing="24">

                        <TextBlock x:Uid="AcercaDeParticipantes"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <!-- Alejandro -->

                        <Border Background="#18FFFFFF"
                                CornerRadius="18"
                                Padding="18"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Alejandro Rodriguez Santos"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Alejandro.Rodriguez38@alu.uclm.es"
                                           FontSize="16"
                                           Foreground="#D6E4FF"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Belén -->

                        <Border Background="#18FFFFFF"
                                CornerRadius="18"
                                Padding="18"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Maria Belen Gallego-Casilda Sanchez"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="MBelen.Gallego@alu.uclm.es"
                                           FontSize="16"
                                           Foreground="#D6E4FF"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Pedro -->

                        <Border Background="#18FFFFFF"
                                CornerRadius="18"
                                Padding="18"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Pedro Vizcaino Arroyo"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Pedro.Vizcaino1@alu.uclm.es"
                                           FontSize="16"
                                           Foreground="#D6E4FF"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Ismael -->

                        <Border Background="#18FFFFFF"
                                CornerRadius="18"
                                Padding="18"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Ismael Serrano Usero"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Ismael.Serrano3@alu.uclm.es"
                                           FontSize="16"
                                           Foreground="#D6E4FF"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- FOOTER -->

                <Border Background="#18FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18"
                        Margin="0,0,0,20">

                    <StackPanel Spacing="8">

                        <TextBlock x:Uid="AcercaDeProyecto"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Uid="AcercaDeCurso"
                                   FontSize="16"
                                   Foreground="#D6E4FF"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>