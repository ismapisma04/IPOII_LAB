                            <Ellipse x:Name="pupilaDer"    Canvas.Left="268" Canvas.Top="177" Width="48" Height="52" Fill="#042C53"/>
                            <Ellipse                        Canvas.Left="272" Canvas.Top="181" Width="40" Height="44" Fill="#185FA5"/>
