<UserControl
    x:Class="ProyectoUWPenBlanco.BrasitalEHA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- IDLE: flota arriba/abajo + sombra se encoge -->
        <Storyboard x:Name="aniIdle" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.82" Duration="0:0:2"/>
        </Storyboard>

        <!-- ALAS: rotan alternadas -->
        <Storyboard x:Name="aniAlas" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="rotAlaIzq"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-14" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="rotAlaDer"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="14" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ATAQUE FUERTE: sacudida rápida + alas abiertas -->
        <Storyboard x:Name="aniAtaqueFuerte">
            <!-- Salto hacia adelante -->
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                 Storyboard.TargetProperty="Y"
                 From="0" To="-30"
                 Duration="0:0:0.1"
                 AutoReverse="True"/>

            <!-- Giro ligero -->
            <DoubleAnimation Storyboard.TargetName="CuerpoRotate"
                 Storyboard.TargetProperty="Angle"
                 From="0" To="15"
                 Duration="0:0:0.1"
                 AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="AtaqueTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="35" Duration="0:0:0.05"
                             AutoReverse="True" RepeatBehavior="3x"/>
            <DoubleAnimation Storyboard.TargetName="rotAlaIzq"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-38" Duration="0:0:0.08"
                             AutoReverse="True" RepeatBehavior="3x"/>
            <DoubleAnimation Storyboard.TargetName="rotAlaDer"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="38" Duration="0:0:0.08"
                             AutoReverse="True" RepeatBehavior="3x"/>
        </Storyboard>

        <!-- ATAQUE FLOJO: empuje suave -->
        <Storyboard x:Name="aniAtaqueFlojo">
            <DoubleAnimation Storyboard.TargetName="AtaqueTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="18" Duration="0:0:0.2"
                             AutoReverse="True" RepeatBehavior="2x"/>
        </Storyboard>

        <!-- DEFENSA: retrocede + escudo + flash + inclina -->
        <Storyboard x:Name="aniDefensaShake">
            <DoubleAnimation Storyboard.TargetName="AtaqueTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="-18" Duration="0:0:0.06"
                             AutoReverse="True" RepeatBehavior="4x"/>
        </Storyboard>
        <Storyboard x:Name="aniDefensaEscudo">
            <DoubleAnimation Storyboard.TargetName="escudo"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"
                             AutoReverse="True" RepeatBehavior="4x"/>
        </Storyboard>
        <Storyboard x:Name="aniDefensaFlash">
            <DoubleAnimation Storyboard.TargetName="overlayDefensa"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="0" Duration="0:0:0.5"/>
        </Storyboard>
        <Storyboard x:Name="aniDefensaRetroceso">
            <DoubleAnimation Storyboard.TargetName="CuerpoRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-12" Duration="0:0:0.15"
                             AutoReverse="True" RepeatBehavior="2x">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- DESCANSAR: baja suavemente -->
        <Storyboard x:Name="aniDescansar">
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                             Storyboard.TargetProperty="Y"
                             To="12" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- CANSADO / NO CANSADO: alas caen y suben -->
        <Storyboard x:Name="aniCansado">
            <!-- Alas caídas -->
            <DoubleAnimation Storyboard.TargetName="rotAlaIzq"
                     Storyboard.TargetProperty="Angle"
                     To="22" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="rotAlaDer"
                     Storyboard.TargetProperty="Angle"
                     To="-22" Duration="0:0:0.5"/>

            <!-- Cuerpo se inclina -->
            <DoubleAnimation Storyboard.TargetName="CuerpoRotate"
                     Storyboard.TargetProperty="Angle"
                     To="10" Duration="0:0:0.5"/>

            <!-- Baja un poco (cansancio) -->
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                     Storyboard.TargetProperty="Y"
                     To="10" Duration="0:0:0.5"/>
        </Storyboard>
        <Storyboard x:Name="aniNoCansado">
            <!-- Alas vuelven -->
            <DoubleAnimation Storyboard.TargetName="rotAlaIzq"
                     Storyboard.TargetProperty="Angle"
                     To="0" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="rotAlaDer"
                     Storyboard.TargetProperty="Angle"
                     To="0" Duration="0:0:0.5"/>

            <!-- Cuerpo vuelve recto -->
            <DoubleAnimation Storyboard.TargetName="CuerpoRotate"
                     Storyboard.TargetProperty="Angle"
                     To="0" Duration="0:0:0.5"/>

            <!-- Vuelve a posición original -->
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                     Storyboard.TargetProperty="Y"
                     To="0" Duration="0:0:0.5"/>
        </Storyboard>
        <!-- HERIDO: overlay rojo pulsa -->
        <Storyboard x:Name="aniHerido" RepeatBehavior="Forever">

            <!-- rojo SIEMPRE visible -->
            <DoubleAnimation Storyboard.TargetName="overlayHerido"
                     Storyboard.TargetProperty="Opacity"
                     To="0.5"
                     Duration="0:0:0"/>

            <!-- vibración del Pokémon -->
            <DoubleAnimation Storyboard.TargetName="AtaqueTransform"
                     Storyboard.TargetProperty="X"
                     From="-6" To="6"
                     Duration="0:0:0.05"
                     AutoReverse="True"
                     RepeatBehavior="Forever"/>

            <!-- movimiento del círculo rojo -->
            <DoubleAnimation Storyboard.TargetName="overlayHeridoMove"
                     Storyboard.TargetProperty="X"
                     From="-4" To="4"
                     Duration="0:0:0.1"
                     AutoReverse="True"
                     RepeatBehavior="Forever"/>
            <!-- movimiento del overlay rojo + vibración de la cola -->
            <DoubleAnimation Storyboard.TargetName="colaRotate"
                 Storyboard.TargetProperty="Angle"
                 From="-20" To="20"
                 Duration="0:0:0.1"
                 AutoReverse="True"
                 RepeatBehavior="Forever"/>

        </Storyboard>
        <!-- DERROTA: cae + gira + estrellas -->
        <Storyboard x:Name="aniDerrota">
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                             Storyboard.TargetProperty="Y"
                             To="90" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <BounceEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CuerpoRotate"
                             Storyboard.TargetProperty="Angle"
                             To="85" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="estrellas"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="rotEstrellas"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.8"
                             RepeatBehavior="Forever"/>
        </Storyboard>


        <Storyboard x:Name="aniEscudoActivo" RepeatBehavior="Forever" AutoReverse="True">

            <!-- Escudo: escala y brillo -->
            <DoubleAnimation Storyboard.TargetName="escudoScale"
                     Storyboard.TargetProperty="ScaleX"
                     From="1" To="1.1"
                     Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="escudoScale"
                     Storyboard.TargetProperty="ScaleY"
                     From="1" To="1.1"
                     Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="escudo"
                     Storyboard.TargetProperty="Opacity"
                     From="0.4" To="0.8"
                     Duration="0:0:0.4"/>

            <!-- Cola: ligera rotación -->
            <DoubleAnimation Storyboard.TargetName="colaRotate"
                     Storyboard.TargetProperty="Angle"
                     From="-6" To="6"
                     Duration="0:0:0.6"/>
        </Storyboard>
        
        <!-- Cola: ligera rotación en Idle-->

        <Storyboard x:Name="aniColaIdle" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="colaRotate"
                     Storyboard.TargetProperty="Angle"
                     From="-8" To="8" Duration="0:0:1.2"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="gridPrincipal">

        <Rectangle x:Name="rectFondo" Visibility="Collapsed">
            <Rectangle.Fill>
                <ImageBrush ImageSource="ms-appx:///Assets/background2.jpg" Stretch="Fill"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRAS HP / EP -->
            <Border x:Name="panelBarras" Grid.Row="0" Background="#AA000000" CornerRadius="10" Padding="12,8" Margin="8,8,8,4" Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <Grid x:Name="filaVida" Margin="0,0,0,5" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#10084;" FontSize="16" Foreground="#FF4455" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="HP" FontSize="11" FontWeight="Bold" Foreground="#FF4455" VerticalAlignment="Center" Width="22" Margin="0,0,8,0"/>
                        <ProgressBar Grid.Column="2" x:Name="pbVida" Minimum="0" Maximum="100" Value="100" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="#FF4455" Background="#33FFFFFF"/>
                        <Border Grid.Column="3" x:Name="pocimaVida" Background="#CCFF4466" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Canvas Width="22" Height="30" Margin="0,0,6,0">
                                    <Rectangle Canvas.Left="7" Canvas.Top="0" Width="8" Height="5" Fill="#333333" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="4" Width="6" Height="5" Fill="#CC3333"/>
                                    <Ellipse Canvas.Left="1" Canvas.Top="8" Width="20" Height="20" Fill="#FF3333" Stroke="#AA1111" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="5" Canvas.Top="11" Width="5" Height="5" Fill="White" Opacity="0.5"/>
                                </Canvas>
                                <TextBlock Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="filaEnergia" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#9889;" FontSize="16" Foreground="#FF70C152" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="EP" FontSize="11" FontWeight="Bold" Foreground="#FF67CD42" VerticalAlignment="Center" Width="22" Margin="0,0,8,0"/>
                        <ProgressBar Grid.Column="2" x:Name="pbEnergia" Minimum="0" Maximum="100" Value="100" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="#44FF44" Background="#33FFFFFF"/>
                        <Border Grid.Column="3" x:Name="pocimaEnergia" Background="#CC4BC540" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Canvas Width="22" Height="30" Margin="0,0,6,0">
                                    <Rectangle Canvas.Left="7" Canvas.Top="0" Width="8" Height="5" Fill="#333333" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="4" Width="6" Height="5" Fill="#FF16DF31"/>
                                    <Ellipse Canvas.Left="1" Canvas.Top="8" Width="20" Height="20" Fill="#FF5EBC36" Stroke="#FF58D648" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="5" Canvas.Top="11" Width="5" Height="5" Fill="White" Opacity="0.5"/>
                                </Canvas>
                                <TextBlock  Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- MiPokémon -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10"
                Width="400" Height="400">
