            <Image x:Name="imgRayo" Source="/AssetsSnorlaxISU/Rayo.png" Width="30" Height="30" Margin="10,0" VerticalAlignment="Center" PointerPressed="probarTambor" />
            <ProgressBar x:Name="pbEnergy" Grid.Column="1" Height="30" Minimum="0" Maximum="100" Value="80" 
                  Foreground="Yellow" Background="#44FFFF00" BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center"/>
            <Ellipse x:Name="imYellowPotion" Grid.Column="2" Width="40" Height="40" Fill="Yellow" Stroke="Goldenrod" StrokeThickness="2" Margin="10,0" PointerPressed="useYellowPotion"/>
        </Grid>
