<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProyectoVacioUWP_Base.SnorlaxISU"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProyectoVacioUWP_Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



    <UserControl.Resources>
        <Storyboard x:Name="Saludo_BrazoDerech" RepeatBehavior="2x" AutoReverse="True">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="canvas" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-90.291"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="Saludo_BrazoIzq" RepeatBehavior="2x" AutoReverse="True">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Brazo_Izq" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-2.797"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="92.708"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="Snorlax_Triste">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Boca_Completa" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="-1.001"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Boca_Completa" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="49.034"/>
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Colmillo_Izquierdo" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:01.5000000">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Colmillo_Derecho" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:01.5000000">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="Snorlax_Feliz">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Boca_Completa" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-1.001"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Boca_Completa" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="49.034"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Colmillo_Izquierdo" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:00">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Colmillo_Derecho" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:00">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="Tambor_Z" RepeatBehavior="2x">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Snorlax" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.25" Value="-31.831"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.75" Value="31.831"/>
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="Activacion_Escudo">
            <DoubleAnimation Duration="00:00:03" Storyboard.TargetName="Cabeza_Entera" To="3.214" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"/>
            <DoubleAnimation Duration="00:00:03" Storyboard.TargetName="Cabeza_Entera" To="118.929" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"/>
        </Storyboard>
        <Storyboard x:Name="Descanso_Snorlax">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza_Entera" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="-3.214"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cabeza_Entera" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:03" Value="99.643"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="elFondoOjoI" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="ptPupilaI" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="elFondoOjoD" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="ptPupilaD" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="ttParpadoI" To="0" Storyboard.TargetProperty="Y"/>
            <DoubleAnimation Duration="00:00:01" Storyboard.TargetName="ttParpadoD" To="0" Storyboard.TargetProperty="Y"/>
        </Storyboard>
        <Storyboard x:Name="Snorlax_Herido">
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="elFondoOjoI" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ptPupilaI" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="elFondoOjoD" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ptPupilaD" To="0" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ttParpadoI" To="0" Storyboard.TargetProperty="Y"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ttParpadoD" To="0" Storyboard.TargetProperty="Y"/>
        </Storyboard>
        <Storyboard x:Name="Snorlax_NoHerido">
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="elFondoOjoI" To="1" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ptPupilaI" To="1" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="elFondoOjoD" To="1" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ptPupilaD" To="1" Storyboard.TargetProperty="Opacity"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ttParpadoI" To="-35" Storyboard.TargetProperty="Y"/>
            <DoubleAnimation Duration="00:00:00.5" Storyboard.TargetName="ttParpadoD" To="-35" Storyboard.TargetProperty="Y"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="imFondo" 
        Source="/AssetsSnorlaxISU/fondo_snorlax.jpg" 
        Stretch="UniformToFill" 
        Grid.RowSpan="4" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <CompositeTransform/>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="imTamborZ" 
        Source="/AssetsSnorlaxISU/Tambor_Z_Animacion.jpg" 
        Stretch="UniformToFill" 
        Grid.RowSpan="4"
        Visibility="Collapsed"
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" />

        <Grid Grid.Row="0" Margin="20,10,20,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgCorazon" Source="/AssetsSnorlaxISU/Corazón.png" Width="30" Height="30" Margin="10,0" VerticalAlignment="Center"/>
            <ProgressBar x:Name="pbHealth" Grid.Column="1" Height="30" Minimum="0" Maximum="100" Value="100" 
                  Foreground="Red" Background="#44FF0000" BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center"/>
            <Ellipse x:Name="imRedPotion" Grid.Column="2" Width="40" Height="40" Fill="Red" Stroke="White" StrokeThickness="2" Margin="10,0" PointerPressed="useRedPotion"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20,5,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
